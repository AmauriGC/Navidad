  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ArbolNavidad
  textoAccion: "\xC1rbol"
  etapas:
  - nombre: Maceta
    tipoPieza: Maceta
    pista: "Dicen que qued\xF3 en el establo, junto a los renos."
    partes:
    - {fileID: 4512099178720157688}
  - nombre: Ramas
    tipoPieza: Rama
    pista: Los cascanueces las tiraron por todo el taller.
    partes:
    - {fileID: 5617784766848132477}
    - {fileID: 1668900158023185096}
    - {fileID: 5639062413760609771}
  - nombre: Esferas
    tipoPieza: Esfera
    pista: Brillan en la oscuridad... busca sobre las mesas.
    partes:
    - {fileID: 6208474306434897}
    - {fileID: 6810069718754263246}
    - {fileID: 8620123409166534042}
    - {fileID: 423163279904021124}
    - {fileID: 5386495371986589033}
    - {fileID: 8828928412057946658}
  - nombre: Guirnalda de luces
    tipoPieza: Guirnalda
    pista: "Un reno se la llev\xF3 enredada en los cuernos."
    partes:
    - {fileID: 4346401058956001262}
  - nombre: Estrella
    tipoPieza: Estrella
    pista: "Est\xE1 en lo alto de la repisa del oeste. \xA1Salta!"
    partes:
    - {fileID: 3105309371892853487}
  duracionAparecer: 0.6
  lucesProgreso:
