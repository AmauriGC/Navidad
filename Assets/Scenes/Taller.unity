  m_Script: {fileID: 11500000, guid: 43cb04c8ab07b499481503beb99a5490, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Letrero
  textoAccion: Leer
  titulo: "P\xE1gina de un diario"
  texto: "<i>\"Esta noche o\xED pasos de madera en el techo. Tac, tac, tac.\n\nMi abuela dec\xEDa que los juguetes con ojos pintados por una m\xE1quina despiertan en Nochebuena, con la cuerda que ella les da...\n\n...y que solo se duermen con la luz del Gran \xC1rbol cuando est\xE1 completo.\"</i>"
  comentarioTilo: "La luz del Gran \xC1rbol... \xA1Tengo que terminarlo!"
  indicadorNuevo: {fileID: 821419202}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
