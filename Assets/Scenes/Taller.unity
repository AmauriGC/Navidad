  m_Script: {fileID: 11500000, guid: 43cb04c8ab07b499481503beb99a5490, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Letrero
  textoAccion: Leer
  titulo: "AVISO: M\xE1quina 7"
  texto: "<b>FUERA DE SERVICIO</b>\n\nDesde el martes le pinta OJOS a todos los juguetes y les da cuerda de m\xE1s.\nAyer le pint\xF3 ojos a una escoba: barri\xF3 sola toda la noche.\n\nLe falta: un engrane, un resorte y el fusible grande.\n\nNo encender. No acercarse. No mirarla fijamente.\n\n\u2014 Taller de Mantenimiento"
  comentarioTilo: "\xBFOjos? \xBFY cuerda...? Ay, no."
  indicadorNuevo: {fileID: 975046215}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
