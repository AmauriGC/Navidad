  m_Script: {fileID: 11500000, guid: 43cb04c8ab07b499481503beb99a5490, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Letrero
  textoAccion: Leer
  titulo: "Instrucciones del Gran \xC1rbol"
  texto: "<b>Orden de armado:</b>\n\n1. La maceta\n2. Tres ramas (de abajo hacia arriba)\n3. Seis esferas\n4. La guirnalda de luces\n5. La estrella, al final\n\nSiempre en ese orden. Lleva cada pieza al tapete y presiona [E] junto al \xE1rbol.\n\n<size=26>Si la estrella se rompe: solo la M\xE1quina 7 sabe hacer una nueva.</size>"
  comentarioTilo: "Bien. Primero la maceta... dicen que qued\xF3 en el establo."
  indicadorNuevo: {fileID: 894125724}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
