  m_Script: {fileID: 11500000, guid: 43cb04c8ab07b499481503beb99a5490, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Letrero
  textoAccion: Leer
  titulo: Tablero de turnos
  texto: "<b>TURNO DE NOCHE:</b> Tilo\n\n1. Cuidar el Gran \xC1rbol hasta que regrese Santa.\n2. NO tocar la M\xE1quina 7 (sigue descompuesta... y anda sentimental).\n3. Dar de comer a los renos a las 6:00 a.m.\n\nP.D. La charola de galletas de Santa va junto a la chimenea. NO se las coman.\n\n\u2014 Jefe de Elfos"
  comentarioTilo: "Cuidar el \xE1rbol... s\xED, claro. Qu\xE9 podr\xEDa salir mal."
  indicadorNuevo: {fileID: 265120703}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
