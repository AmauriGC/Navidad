  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Letrero
  textoAccion: Leer
  titulo: Reglamento del establo
  texto: "\u2022 Los renos comen a las 6:00 a.m.\n\u2022 Rodolfo NO comparte su heno.\n\u2022 Si un reno se enreda con algo, NO lo jalen: se pone de malas.\n  Una zanahoria lo arregla todo.\n\u2022 Prohibido volar dentro del establo.\n\n\u2014 Jefa de Renos"
  comentarioTilo: "Una zanahoria... \xBFde d\xF3nde saco una zanahoria a esta hora?"
  indicadorNuevo: {fileID: 199105681}
  alLeer:
    m_PersistentCalls:
      m_Calls: []
